        {
          "name": "calculator",
          "max_calls": 1
        }
      ],
      "order": [
        [
          "lookup_fact",
          "calculator"
        ]
      ],
      "dependencies": [
        {
          "source": "lookup_fact",
          "target": "calculator",
          "argument": "/expression",
          "match": "contains"
        }
      ]
    }
  },
